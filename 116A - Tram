import java.util.Scanner;

public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        
        int count=0; 
        int maxcount=0;
        
        for(int i=0;i<n;i++)
        {
            int a=sc.nextInt();
            int b=sc.nextInt();
            
            count=count-a+b;
            
            if(count>maxcount)
                maxcount=count;
        }
        System.out.print(maxcount);
        
        sc.close();
    }
}
