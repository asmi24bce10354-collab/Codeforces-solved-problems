import java.util.Scanner;

public class Main
{
    public static void main(String[]args)
    {
        Scanner sc=new Scanner(System.in);
        
        int n=sc.nextInt();
        int [] nums = new int [n];
        boolean flag=false;
        
        for (int i = 0; i < n; i++) 
        {
            nums[i] = sc.nextInt();
            
            if (nums[i] == 1) 
                flag = true;
        }

        if (flag==true)
            System.out.println("HARD");
        else
            System.out.println("EASY");

        sc.close();
    }
}
